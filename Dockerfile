# ==============================================================================
# Multi-stage Dockerfile for NearBee Production Deployment (Render / Cloud)
# Course: Cloud Computing for Data Analytics (23DC2043)
# ==============================================================================

# ----------------- Stage 1: Builder -----------------
FROM node:20-alpine AS builder

WORKDIR /app

# Install build dependencies required by any native modules
RUN apk add --no-cache libc6-compat python3 make g++

# Copy package manifests
COPY package.json package-lock.json ./

# Install dependencies (respecting package-lock)
RUN npm ci --legacy-peer-deps || npm install --legacy-peer-deps

# Copy application source code and configuration
COPY . .

# Set Nitro preset for standalone Node.js production server
ENV NITRO_PRESET=node-server
ENV NODE_ENV=production

# Build client and server bundles
RUN npm run build

# ----------------- Stage 2: Production Runner -----------------
FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=10000
ENV HOST=0.0.0.0

# Security best practice: Create non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001

# Copy compiled production artifacts from builder stage
COPY --from=builder --chown=nodejs:nodejs /app/.output ./.output
COPY --from=builder --chown=nodejs:nodejs /app/package.json ./package.json
COPY --from=builder --chown=nodejs:nodejs /app/public ./public

# Switch to unprivileged user
USER nodejs

# Expose Render default port
EXPOSE 10000

# Container healthcheck
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:10000/ || exit 1

# Launch the optimized Node server generated by Nitro
CMD ["node", ".output/server/index.mjs"]

